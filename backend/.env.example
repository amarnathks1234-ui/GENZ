# NEXORA FastAPI Environment Configuration
PROJECT_NAME="NEXORA E-Commerce API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
SECRET_KEY="nexora-super-secure-production-ready-jwt-secret-key-replace-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Supabase or SQLite for local dev/testing)
# For Supabase PostgreSQL:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-REF].supabase.co:5432/postgres"
# For Local SQLite (works out of the box for testing and development):
DATABASE_URL="sqlite:///./nexora.db"

# Supabase Credentials (Optional for direct SDK integrations)
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_KEY="your-supabase-anon-or-service-role-key"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5500,http://localhost:8000,http://127.0.0.1:5500,http://127.0.0.1:8000,http://127.0.0.1:3000,null,*"

# Payment Gateway Configuration (Stripe / Razorpay / Mock)
PAYMENT_GATEWAY="mock"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
